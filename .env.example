# EcoChain Copilot — Root environment variables
# Copy to .env and customise.

# --- Auth ---
# Set to false for the no-login demo mode (default).
# Set to true to re-enable full JWT authentication.
AUTH_ENABLED=false

# --- Database ---
DATABASE_URL=postgresql+psycopg://ecochain:ecochain_dev_only@localhost:5433/ecochain

# --- Redis ---
REDIS_URL=redis://localhost:6380/0

# --- LLM Provider ---
# Use "fake" for local/demo mode (no API key needed).
# Use "gemini" for real Gemini calls (requires GEMINI_API_KEY).
LLM_PROVIDER=fake

# --- Gemini (optional — only needed if LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash

# --- Workflow ---
WORKFLOW_SERVICES_FACTORY=backend.app.graph.services:create_workflow_services
