# Environment Configuration for EcoChain Copilot

# Deployment & Security
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
VAULT_ENCRYPTION_KEY=dGVzdF92YXVsdF9lbmNyeXB0aW9uX2tleV8zMmJ5dGVzISE=

# Database & Cache
POSTGRES_DB=ecochain
POSTGRES_USER=ecochain
POSTGRES_PASSWORD=ecochain_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://ecochain:ecochain_dev_only@localhost:5432/ecochain
TEST_DATABASE_URL=postgresql+psycopg://ecochain:ecochain_dev_only@localhost:5432/ecochain_test
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Never hardcode model names; always use GEMINI_MODEL)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Feature Flags
LLAMA_REDACTION_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Local OCR / Model Config
TESSERACT_CMD=
LAYOUTLM_WEIGHTS_PATH=
